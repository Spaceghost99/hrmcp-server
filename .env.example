# =============================================================================
# hrmcp-server environment variables
# =============================================================================
# Copy this file to .env and fill in the values.
# .env is never committed. This file is.
#
# Variables marked REQUIRED have no default and will crash the server on
# startup if missing. All others are optional with the shown default.
# =============================================================================


# ── Server ────────────────────────────────────────────────────────────────────

# Port the HTTP server listens on.
# Railway sets this automatically — do not override it in production.
PORT=3000

# Runtime environment. Set to "production" on Railway.
NODE_ENV=development


# ── Anthropic ─────────────────────────────────────────────────────────────────

# REQUIRED — your Anthropic API key. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model used for candidate scoring. Defaults to claude-sonnet-4-20250514.
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Maximum milliseconds to wait for an Anthropic API response before timing out.
ANTHROPIC_TIMEOUT_MS=25000


# ── Database ──────────────────────────────────────────────────────────────────

# REQUIRED in production — PostgreSQL connection string.
# Railway provides this automatically when you attach a Postgres service.
# Leave blank to run without a database (scoring works; auth and billing do not).
DATABASE_URL=


# ── Authentication ────────────────────────────────────────────────────────────

# bcrypt cost factor for hashing API keys at creation time.
# 10 is the recommended minimum. Higher values slow down key creation only —
# not authentication, which uses the stored hash.
BCRYPT_ROUNDS=10


# ── Rate limiting ─────────────────────────────────────────────────────────────

# Set to "false" to disable rate limiting entirely.
# Intended for self-hosted deployments that enforce limits at the network layer.
RATE_LIMIT_ENABLED=true

# Maximum requests per API key per minute (rolling window).
RATE_LIMIT_PER_MINUTE=30

# Maximum requests per API key per day (rolling window).
RATE_LIMIT_PER_DAY=500

# Maximum simultaneous in-flight requests per API key.
RATE_LIMIT_CONCURRENT=5


# ── Payload limits ────────────────────────────────────────────────────────────

# Maximum character length for resume_text input.
MAX_RESUME_CHARS=15000

# Maximum character length for job_description input.
MAX_JD_CHARS=15000


# ── Stripe billing ────────────────────────────────────────────────────────────

# REQUIRED in production — Stripe secret key.
# Use sk_test_... during development and sk_live_... in production.
# Never commit the live key.
STRIPE_SECRET_KEY=

# REQUIRED in production — signing secret for the /webhooks/stripe endpoint.
# Copy this from the Stripe dashboard after registering the webhook.
STRIPE_WEBHOOK_SECRET=

# Lookup key of the Stripe price object for one credit bundle.
# Must match the lookup_key set on the price in the Stripe dashboard.
STRIPE_PRICE_LOOKUP_KEY=credits_100

# Number of credits granted per purchase. Must match the Stripe price metadata.
CREDITS_BUNDLE_SIZE=100

# Number of days before purchased credits expire.
CREDITS_EXPIRY_DAYS=180


# ── Logging ───────────────────────────────────────────────────────────────────

# Log verbosity. "info" emits one JSON line per request.
# "error" suppresses request logs and only emits errors and billing events.
LOG_LEVEL=info


# ── Idempotency ───────────────────────────────────────────────────────────────

# How long (in seconds) to cache responses for a given Idempotency-Key header.
# Default is 24 hours (86400 seconds), matching Stripe's idempotency window.
IDEMPOTENCY_TTL_SECONDS=86400


# ── App ───────────────────────────────────────────────────────────────────────

# Public base URL of this deployment. Used in billing redirect links.
# Set to your Railway domain in production, e.g. https://hrmcp-server.up.railway.app
APP_URL=http://localhost:3000
